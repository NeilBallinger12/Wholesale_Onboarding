{
  "name": "@arc-ui/components",
  "version": "13.14.0",
  "homepage": "https://ui.digital-ent-int.bt.com",
  "author": "BT Business Digital UI Team <ui-digital-ent-int@bt.com>",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./src": "./src/index.ts",
    "./styles.ts": "./src/styles.ts",
    "./lib/styles.css": "./lib/styles.css",
    "./lib/*/styles.css": "./lib/*/styles.css",
    "./*": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/*/*.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/*/*.cjs"
      }
    }
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "2.0.0",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-switch": "1.0.3",
    "@radix-ui/react-tabs": "1.0.4",
    "@radix-ui/react-toast": "1.1.4",
    "@radix-ui/react-tooltip": "^1.1.2",
    "cssesc": "^3.0.0",
    "date-fns": "^2.30.0",
    "embla-carousel": "^8.3.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-react": "^8.3.0",
    "fuse.js": "7.5.0",
    "mini-svg-data-uri": "^1.2.3",
    "react-player": "^2.16.0",
    "react-swipeable": "^7.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cssesc": "^3.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "^14.0.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "camelcase": "^6.2.1",
    "classnames": "^2.2.6",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lodash": "^4.17.21",
    "postcss": "^8.0.0",
    "postcss-minify": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.27.4",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-svg-import": "^3.0.0",
    "rollup-preserve-directives": "^1.1.3",
    "style-loader": "^4.0.0",
    "stylelint": "^16.10.0",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "5.6.3",
    "@arc-ui/css-config": "^12.0.0",
    "@arc-ui/gradients": "^13.14.0",
    "@arc-ui/tokens-arc": "^13.14.0",
    "@arc-ui/tokens-bt-enterprise": "^13.14.0",
    "@arc-ui/icons": "^13.14.0",
    "@arc-ui/eslint-config": "^12.0.0",
    "@arc-ui/typescript-config": "^12.0.0",
    "@arc-ui/helpers": "^13.14.0"
  },
  "browserslist": [
    "defaults",
    "last 1 Chrome version",
    "last 1 ChromeAndroid version",
    "last 1 Edge version",
    "last 1 Firefox version",
    "Firefox ESR",
    "Firefox 91",
    "Firefox 78",
    "Firefox 68",
    "Safari >= 14",
    "iOS >= 14",
    "Samsung >= 16",
    "not IE 11",
    "not Edge < 18",
    "not and_qq > 0",
    "not UCAndroid > 0",
    "not OperaMini all"
  ],
  "scripts": {
    "lint:ts": "eslint .",
    "lint:css": "stylelint '**/*.css'",
    "ts:check": "tsc --noEmit",
    "test": "TZ=UTC jest",
    "test:changed": "TZ=UTC jest --onlyChanged",
    "test:coverage": "TZ=UTC jest --coverage",
    "test:watch": "TZ=UTC jest --watch",
    "test:ci": "TZ=UTC jest",
    "build": "rimraf lib && rollup -c && node ./scripts/subpath-postcss.mjs && pnpm run build:clean",
    "build:clean": "rimraf ./lib/types ./lib/styles.js ./lib/index.js",
    "generate:component": "node ./generate-component $1"
  }
}