{
  "name": "@arc-ui/icons",
  "version": "13.14.0",
  "homepage": "https://ui.digital-ent-int.bt.com",
  "author": "BT Business Digital UI Team <ui-digital-ent-int@bt.com>",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./bt-svg": {
      "import": {
        "types": "./lib/bt-svg.d.mts",
        "default": "./lib/bt-svg.mjs"
      },
      "require": {
        "types": "./lib/bt-svg.d.cts",
        "default": "./lib/bt-svg.cjs"
      }
    },
    "./ee-svg": {
      "import": {
        "types": "./lib/ee-svg.d.mts",
        "default": "./lib/ee-svg.mjs"
      },
      "require": {
        "types": "./lib/ee-svg.d.cts",
        "default": "./lib/ee-svg.cjs"
      }
    },
    "./lib/component-icons-bt.css": "./lib/component-icons-bt.css",
    "./lib/component-icons-ee.css": "./lib/component-icons-ee.css",
    "./lib/tokens-bt.css": "./lib/tokens-bt.css",
    "./lib/tokens-bt.scss": "./lib/tokens-bt.scss",
    "./lib/tokens-ee.css": "./lib/tokens-ee.css",
    "./lib/tokens-ee.scss": "./lib/tokens-ee.scss",
    "./icon-names-bt": "./lib/icon-names-bt.ts",
    "./icon-names-ee": "./lib/icon-names-ee.ts",
    "./*": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/icons/*/*.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/icons/*/*.cjs"
      }
    }
  },
  "devDependencies": {
    "@prettier/sync": "^0.5.2",
    "@tsconfig/node16": "^16.1.3",
    "@types/lodash": "^4.17.13",
    "@types/node": "^14.0.0",
    "@types/pify": "^5.0.4",
    "eslint": "^9.15.0",
    "lodash": "^4.17.21",
    "mini-svg-data-uri": "^1.2.3",
    "pify": "^5.0.0",
    "rimraf": "^6.0.1",
    "style-dictionary": "^3.0.0",
    "svgo": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "@arc-ui/eslint-config": "^12.0.0"
  },
  "scripts": {
    "lint:ts": "eslint .",
    "build": "rimraf lib && ts-node ./src/build.ts"
  }
}